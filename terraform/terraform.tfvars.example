# Copy this file to terraform.tfvars and edit if needed.
#
# IMPORTANT: For Part II, these values MUST match the Part I deployment
# so that Terraform recognises the existing resources in Azure rather
# than trying to create new ones.

prefix         = "cristinaer"          # same prefix used in Part I
suffix         = "suv4"                # suffix that was generated during Part I
location       = "eastus"              # same region as Part I
environment    = "dev"
owner          = "cristinafiloti@outlook.com"
max_upload_mb  = 10
